[Unit]
Description=Drowsy Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/drowsy_bot
EnvironmentFile=/root/drowsy_bot/.env
ExecStart=/usr/bin/node /root/drowsy_bot/index.js
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target